	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<delete id="deleteQustnrRespondInfo" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.deleteQustnrRespondInfo */
		DELETE FROM LETTNQUSTNRRSPNSRESULT
