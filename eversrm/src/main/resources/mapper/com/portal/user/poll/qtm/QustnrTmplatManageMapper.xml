	====================================================================================================
	 4. 연계 삭제: 설문 항목(보기) 삭제
	  - 설명: 템플릿 삭제 전 종속된 설문 항목(LETTNQUSTNRIEM) 레코드를 일괄 삭제합니다.
	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<delete id="deleteQustnrItemManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.deleteQustnrItemManage */
		DELETE FROM LETTNQUSTNRIEM
		 WHERE QUSTNR_TMPLAT_ID = #{qestnrTmplatId}
	</delete>

	<!--
	====================================================================================================
	 5. 연계 삭제: 설문 문항(질문) 삭제
	  - 설명: 템플릿 삭제 전 종속된 설문 문항(LETTNQUSTNRQESITM) 레코드를 일괄 삭제합니다.
	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<delete id="deleteQustnrQestnManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.deleteQustnrQestnManage */
		DELETE FROM LETTNQUSTNRQESITM
		 WHERE QUSTNR_TMPLAT_ID = #{qestnrTmplatId}
	</delete>

	<!--
	====================================================================================================
	 6. 연계 삭제: 설문지 마스터 삭제
	  - 설명: 템플릿 삭제 전 종속된 설문 정보(LETTNQESTNRINFO) 레코드를 일괄 삭제합니다.
	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<delete id="deleteQustnrManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.deleteQustnrManage */
		DELETE FROM LETTNQESTNRINFO
		 WHERE QUSTNR_TMPLAT_ID = #{qestnrTmplatId}
	</delete>

	<!--
	====================================================================================================
	 7. 설문 템플릿 본체 삭제
	  - 설명: 설문 템플릿 마스터(LETTNQUSTNRTMPLAT) 레코드를 삭제합니다.
	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<delete id="deleteQustnrTmplatManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.deleteQustnrTmplatManage */
		DELETE FROM LETTNQUSTNRTMPLAT
		 WHERE QUSTNR_TMPLAT_ID = #{qestnrTmplatId}
	</delete>

	<!--
	====================================================================================================
	 8. 설문 템플릿 정보 수정
	  - 설명: 설문 템플릿의 유형, 설명, 파일경로, 이미지(선택적)를 수정합니다.
	  - 파라미터: qestnrTmplatImagepathnm, qestnrTmplatTy, qestnrTmplatCn, qestnrTmplatCours, lastUpdusrId, qestnrTmplatId
	====================================================================================================
	-->
	<update id="updateQustnrTmplatManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.updateQustnrTmplatManage */
		UPDATE LETTNQUSTNRTMPLAT
		   SET
		<if test="qestnrTmplatImagepathnm != null">
		       QUSTNR_TMPLAT_IMAGE_INFO = #{qestnrTmplatImagepathnm,jdbcType=BLOB},
		</if>
		       QUSTNR_TMPLAT_TY         = #{qestnrTmplatTy},
		       QUSTNR_TMPLAT_DC         = #{qestnrTmplatCn},
		       QUSTNR_TMPLAT_PATH_NM    = #{qestnrTmplatCours},
		       LAST_UPDT_PNTTM          = SYSDATE(),
		       LAST_UPDUSR_ID           = #{lastUpdusrId}
		 WHERE QUSTNR_TMPLAT_ID         = #{qestnrTmplatId}
	</update>

	<!--
	====================================================================================================
	 9. 설문 템플릿 단건 상세 조회
	  - 설명: 템플릿 ID(qestnrTmplatId)의 상세 정보(유형, 설명, 경로, 이미지 등)를 조회합니다.
	  - 파라미터: qestnrTmplatId
	====================================================================================================
	-->
	<select id="selectQustnrTmplatManageDetail" parameterType="map" resultType="egovMap">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.selectQustnrTmplatManageDetail */
		SELECT
			QUSTNR_TMPLAT_ID                             AS qestnrTmplatId,
			QUSTNR_TMPLAT_TY                             AS qestnrTmplatTy,
			DATE_FORMAT(FRST_REGIST_PNTTM, '%Y-%m-%d')  AS FRST_REGIST_PNTTM,
			FRST_REGISTER_ID,
			DATE_FORMAT(LAST_UPDT_PNTTM, '%Y-%m-%d')    AS LAST_UPDT_PNTTM,
			LAST_UPDUSR_ID,
			QUSTNR_TMPLAT_IMAGE_INFO                     AS qestnrTmplatImagepathnm,
			QUSTNR_TMPLAT_DC                             AS qestnrTmplatCn,
			QUSTNR_TMPLAT_PATH_NM                        AS qestnrTmplatCours
		  FROM LETTNQUSTNRTMPLAT
		 WHERE QUSTNR_TMPLAT_ID = #{qestnrTmplatId}
	</select>

	<!--
	====================================================================================================
	 10. 설문 템플릿 목록 페이징 조회
	  - 설명: 등록된 설문 템플릿 목록을 페이징 및 유형/설명 검색 조건으로 조회합니다.
	  - 파라미터: searchCondition, searchKeyword, recordCountPerPage, firstIndex
	====================================================================================================
	-->
	<select id="selectQustnrTmplatManageList" parameterType="map" resultType="egovMap">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.selectQustnrTmplatManageList */
		SELECT
			a.QUSTNR_TMPLAT_ID                             AS qestnrTmplatId,
			a.QUSTNR_TMPLAT_TY                             AS qestnrTmplatTy,
			DATE_FORMAT(a.FRST_REGIST_PNTTM, '%Y-%m-%d')  AS FRST_REGIST_PNTTM,
			(
				SELECT u.USER_NM
				  FROM COMVNUSERMASTER u
				 WHERE u.ESNTL_ID = a.FRST_REGISTER_ID
			) AS FRST_REGISTER_NM,
			a.FRST_REGISTER_ID,
			DATE_FORMAT(a.LAST_UPDT_PNTTM, '%Y-%m-%d')    AS LAST_UPDT_PNTTM,
			a.LAST_UPDUSR_ID,
			a.QUSTNR_TMPLAT_IMAGE_INFO                     AS qestnrTmplatImagepathnm,
			a.QUSTNR_TMPLAT_DC                             AS qestnrTmplatCn,
			a.QUSTNR_TMPLAT_PATH_NM                        AS qestnrTmplatCours
		  FROM LETTNQUSTNRTMPLAT a
		 WHERE 1 = 1
		<if test="searchKeyword != null and searchKeyword != ''">
		   <if test="searchCondition == 'QUSTNR_TMPLAT_DC'">
		   AND a.QUSTNR_TMPLAT_DC LIKE CONCAT('%', #{searchKeyword}, '%')
		   </if>
		   <if test="searchCondition == 'QUSTNR_TMPLAT_TY'">
		   AND a.QUSTNR_TMPLAT_TY LIKE CONCAT('%', #{searchKeyword}, '%')
		   </if>
		</if>
		 ORDER BY a.FRST_REGIST_PNTTM DESC
		 LIMIT #{recordCountPerPage} OFFSET #{firstIndex}
	</select>

	<!--
	====================================================================================================
	 11. 설문 템플릿 목록 총 건수 조회
	  - 설명: 설문 템플릿 목록 페이징용 총 건수를 계산합니다.
	  - 파라미터: searchCondition, searchKeyword
	====================================================================================================
	-->
	<select id="selectQustnrTmplatManageListCnt" parameterType="map" resultType="int">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.selectQustnrTmplatManageListCnt */
		SELECT COUNT(*) AS totcnt
		  FROM LETTNQUSTNRTMPLAT
		 WHERE 1 = 1
		<if test="searchKeyword != null and searchKeyword != ''">
		   <if test="searchCondition == 'QUSTNR_TMPLAT_DC'">
		   AND QUSTNR_TMPLAT_DC LIKE CONCAT('%', #{searchKeyword}, '%')
		   </if>
		   <if test="searchCondition == 'QUSTNR_TMPLAT_TY'">
		   AND QUSTNR_TMPLAT_TY LIKE CONCAT('%', #{searchKeyword}, '%')
		   </if>
		</if>
	</select>

	<!--
	====================================================================================================
	 12. 설문 템플릿 신규 등록
	  - 설명: 새로운 설문지 템플릿(유형, 설명, 경로, 이미지 등)을 등록합니다.
	  - 파라미터: qestnrTmplatId, qestnrTmplatTy, qestnrTmplatImagepathnm, qestnrTmplatCn, qestnrTmplatCours, frstRegisterId, lastUpdusrId
	====================================================================================================
	-->
	<insert id="insertQustnrTmplatManage" parameterType="map">
		/* com.portal.user.poll.qtm.QustnrTmplatManageMapper.insertQustnrTmplatManage */
		INSERT INTO LETTNQUSTNRTMPLAT
		(
			QUSTNR_TMPLAT_ID,
			QUSTNR_TMPLAT_TY,
			QUSTNR_TMPLAT_IMAGE_INFO,
			QUSTNR_TMPLAT_DC,
			QUSTNR_TMPLAT_PATH_NM,
			FRST_REGIST_PNTTM,
			FRST_REGISTER_ID,
			LAST_UPDT_PNTTM,
			LAST_UPDUSR_ID
		)
		VALUES
		(
			#{qestnrTmplatId},
			#{qestnrTmplatTy},
			#{qestnrTmplatImagepathnm,jdbcType=BLOB},
			#{qestnrTmplatCn},
			#{qestnrTmplatCours},
			SYSDATE(),
			#{frstRegisterId},
			SYSDATE(),
			#{lastUpdusrId}
		)
	</insert>

</mapper>
